# Application
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# MongoDB (local)
MONGODB_URI=mongodb://localhost:27017/hyperdrive

# Monad
MONAD_RPC_URL=https://rpc.monad.xyz
CHAIN_ID=143

# HyperdriveDesk (from contracts/deployments/143.json)
DESK_ADDRESS=
DESK_DEPLOY_BLOCK=0

# Key that signs EIP-712 quotes. Its address must equal the desk's quoteSigner.
# Use a dedicated key that holds no funds. Never commit it.
QUOTE_SIGNER_PRIVATE_KEY=
QUOTE_TTL_SECONDS=30
# Spread over the xStocks price charged on top of the desk fee (15 = 0.15%).
# Keep spread + fee > 0, or a signed quote is a free option on price moves during its TTL.
QUOTE_SPREAD_BPS=15
# Refuse to sign when the live price jumps more than this % vs the last accepted price
PRICE_BAND_PCT=10
QUOTE_MIN_USDC=1
QUOTE_MAX_USDC=10000

# Trade event indexer
INDEXER_ENABLED=true
INDEXER_POLL_MS=4000
INDEXER_BLOCK_RANGE=100
# Trailing blocks re-scanned every tick (covers a lagging RPC node)
INDEXER_REWIND_BLOCKS=10

CATALOG_PATH=../frontend/data/monad-xstocks.json
SNAPSHOT_INTERVAL_MS=900000

# Market news pipeline (scheduler → Mongo → /api/news).
# NEWS_DATA_API_KEY is tried against NewsData.io first, then reused as NewsAPI.org if needed (Emperor-style).
NEWS_DATA_API_KEY=
NEWS_API_KEY=
NEWS_CACHE_TTL_MS=21600000
NEWS_BATCH_SIZE=30

# AI trading engine (Trading engine page). Set any of these; the form lists what is configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
